{
  "$schema": "../../../docs/keymap-v2.schema.json",
  "formatVersion": "2.0",
  "name": "JISかな",
  "description": "JIS X 6002 標準かな入力配列 (4段単打＋濁点/半濁点後置)",
  "targetScript": "hiragana",
  "base": "positional",
  "behavior": {
    "type": "sequential"
  },
  "inputMappings": {
    "_comment_row0": "数字段",
    "1": "ぬ",
    "2": "ふ",
    "3": "あ",
    "4": "う",
    "5": "え",
    "6": "お",
    "7": "や",
    "8": "ゆ",
    "9": "よ",
    "0": "わ",
    "-": "ほ",
    "=": "へ",
    "_comment_row1": "上段",
    "q": "た",
    "w": "て",
    "e": "い",
    "r": "す",
    "t": "か",
    "y": "ん",
    "u": "な",
    "i": "に",
    "o": "ら",
    "p": "せ",
    "[": "゛",
    "]": "゜",
    "_comment_row2": "中段",
    "a": "ち",
    "s": "と",
    "d": "し",
    "f": "は",
    "g": "き",
    "h": "く",
    "j": "ま",
    "k": "の",
    "l": "り",
    ";": "れ",
    "'": "け",
    "_comment_row3": "下段",
    "z": "つ",
    "x": "さ",
    "c": "そ",
    "v": "ひ",
    "b": "こ",
    "n": "み",
    "m": "も",
    ",": "ね",
    ".": "る",
    "/": "め",
    "\\": "ろ",
    "_comment_dakuten": "濁音 (清音+濁点キー後置)",
    "t[": "が",
    "g[": "ぎ",
    "h[": "ぐ",
    "'[": "げ",
    "b[": "ご",
    "x[": "ざ",
    "d[": "じ",
    "r[": "ず",
    "p[": "ぜ",
    "c[": "ぞ",
    "q[": "だ",
    "a[": "ぢ",
    "z[": "づ",
    "w[": "で",
    "s[": "ど",
    "f[": "ば",
    "v[": "び",
    "2[": "ぶ",
    "=[": "べ",
    "-[": "ぼ",
    "4[": "ゔ",
    "_comment_handakuten": "半濁音 (清音+半濁点キー後置)",
    "f]": "ぱ",
    "v]": "ぴ",
    "2]": "ぷ",
    "=]": "ぺ",
    "-]": "ぽ"
  },
  "lookupTable": {
    "_comment_small": "小文字・促音 (Shift+キー同時修飾)",
    "shift+3": "ぁ",
    "shift+e": "ぃ",
    "shift+4": "ぅ",
    "shift+5": "ぇ",
    "shift+6": "ぉ",
    "shift+7": "ゃ",
    "shift+8": "ゅ",
    "shift+9": "ょ",
    "shift+z": "っ",
    "shift+0": "を"
  }
}
